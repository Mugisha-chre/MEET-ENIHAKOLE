{
  "rewrites": [
    {
      "source": "/share/:slug",
      "destination": "/api/share/:slug"
    },
    {
      "source": "/meeting/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|facebookcatalog|Facebot|meta-externalagent|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Applebot|SkypeUriPreview|Pinterest|vkShare|Iframely|Signal|Viber|Embedly|Mastodon|redditbot|Googlebot|Bingbot|Slack-ImgProxy|Google-InspectionTool|bot|crawler|spider).*"
        }
      ],
      "destination": "/api/share/:slug"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
