VITE_API_URL=http://localhost:4000/api
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=MEET ENIHAKOLE
# Optional: deployed frontend origin used for canonical invitation previews (set to your Vercel URL in production).
FRONTEND_APP_URL=http://localhost:5173
# Optional: explicit backend API base for the server-rendered invitation preview function.
BACKEND_API_URL=http://localhost:4000/api

# Google sign-in (OAuth Web client ID, same value as the backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
