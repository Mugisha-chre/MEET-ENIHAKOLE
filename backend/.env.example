NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
FRONTEND_APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
FRONTEND_ORIGINS=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/meet-enihakole
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
MEETING_MAX_DURATION_MINUTES=240

# Secure server-side Cloudinary meeting-thumbnail uploads
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Optional: only set if you created this signed preset in Cloudinary; uploads work without it.
# CLOUDINARY_UPLOAD_PRESET=meet-enihakole-meeting-covers
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Composited room recording requires a private S3-compatible staging bucket for LiveKit Egress.
RECORDING_S3_BUCKET=your-private-recording-staging-bucket
RECORDING_S3_REGION=us-east-1
RECORDING_S3_ACCESS_KEY=your-recording-staging-access-key
RECORDING_S3_SECRET=your-recording-staging-secret
# Optional for S3-compatible providers (e.g. Cloudflare R2, MinIO).
# RECORDING_S3_ENDPOINT=https://s3.example.com
RECORDING_S3_FORCE_PATH_STYLE=true
RECORDING_UPLOAD_MAX_ATTEMPTS=5
# Optional external cron authentication secret (use a long random value in production).
RECORDING_RETENTION_CRON_SECRET=replace-with-a-long-random-secret

# Public API URL reachable by LiveKit Egress webhooks.
API_PUBLIC_URL=https://your-api.example.com
# Comma-separated Google email addresses allowed to administer the entire platform.
SYSTEM_ADMIN_EMAILS=admin@example.com

# Per-recording upload size limit in bytes (default 20 GB; Cloudinary asset limit applies).
RECORDING_MAX_FILE_BYTES=20000000000
