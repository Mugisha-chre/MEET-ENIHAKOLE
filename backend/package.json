{
  "name": "meet-enihakole-api",
  "version": "1.0.0",
  "private": true,
  "description": "MEET ENIHAKOLE conferencing API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "npm run build",
    "prestart": "node -e \"require('fs').existsSync('dist/server.js')||process.exit(1)\" || npm run build"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.19.0",
    "mongoose": "^8.8.2",
    "typescript": "^5.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": "22.x"
  }
}
